{
  "name": "shopfloor-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic shop-floor dataset and evaluation foundation",
  "engines": {
    "node": "24.14.0",
    "npm": ">=11 <12"
  },
  "scripts": {
    "generate": "tsx src/generator/index.ts",
    "validate": "tsx src/validator/index.ts",
    "scenarios:freeze": "tsx scripts/freeze-scenarios.ts",
    "scenarios:check": "tsx scripts/freeze-scenarios.ts --check",
    "core:demo": "tsx scripts/demo-core.ts",
    "db:copy": "tsx scripts/copy-runtime-db.ts",
    "mcp:start": "node dist/server/index.js",
    "mcp:dev": "tsx src/server/index.ts",
    "mcp:demo": "tsx scripts/demo-mcp.ts",
    "mcp:config": "tsx scripts/mcp-config.ts",
    "preeval": "npm run build",
    "eval": "node dist/eval/runner.js",
    "eval:freeze": "tsx src/eval/manage.ts freeze",
    "eval:review": "tsx src/eval/manage.ts review",
    "eval:sheet": "tsx src/eval/manage.ts sheet",
    "eval:summary": "tsx src/eval/manage.ts summary",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
